# ==============================================================
# Smart Volunteer Connect — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=my-super-secret-key-change-this

# ---------------------------------------------------------------
# DATABASE — SQLite (default, no setup needed!)
# The database file will be created automatically in the project folder.
# Just leave DATABASE_URL commented out to use SQLite.
# ---------------------------------------------------------------
# DATABASE_URL=sqlite:///smart_volunteer_connect.db   <-- this is the default

# ---------------------------------------------------------------
# If you later want to use PostgreSQL (e.g. Neon/Supabase), 
# uncomment and fill in the line below:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ---------------------------------------------------------------

# JWT Settings
JWT_SECRET_KEY=my-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS — Frontend origin (your GitHub Pages URL)
FRONTEND_ORIGIN=https://yashmajmudar-33.github.io

# Mail Settings (optional — leave blank to skip email sending)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=your-email@gmail.com
