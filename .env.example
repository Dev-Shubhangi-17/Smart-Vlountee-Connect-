# ==============================================================
# Smart Volunteer Connect — Environment Variables
# Copy this file to .env and customize for your environment
# ==============================================================

# --------------------------------------------------------------
# Flask Core Settings
# --------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smart-volunteer-connect-production-secret-key-replace-in-prod

# --------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL Recommended)
# --------------------------------------------------------------
# 1. Local PostgreSQL (install PostgreSQL and run: createdb smart_volunteer_connect):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_volunteer_connect

# 2. Cloud PostgreSQL (Neon / Supabase / Render / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 3. SQLite Fallback (no database server installation required for quick local test):
# DATABASE_URL=sqlite:///smart_volunteer_connect_dev.db

# --------------------------------------------------------------
# JWT Authentication Settings
# --------------------------------------------------------------
# Note: Key must be at least 32 characters long for SHA256 security
JWT_SECRET_KEY=smart-volunteer-connect-jwt-secret-key-32bytes-min
JWT_ACCESS_TOKEN_EXPIRES=86400

# --------------------------------------------------------------
# CORS Configuration
# --------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5000

# --------------------------------------------------------------
# Mail Settings (Optional — leave empty to skip email sending)
# --------------------------------------------------------------
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@smartvolunteerconnect.org
